<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.studyinbetterlogin.fragment.LoginFragment"
        android:label="fragment_login"
        tools:layout="@layout/fragment_login" >
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_loginByParrernFragment"
            app:destination="@id/loginByParrernFragment" />
    </fragment>
    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.studyinbetterlogin.fragment.RegisterFragment"
        android:label="fragment_register"
        tools:layout="@layout/fragment_register" >
        <action
            android:id="@+id/action_registerFragment_to_pattrenragment"
            app:destination="@id/pattrenragment" />
    </fragment>
    <fragment
        android:id="@+id/pattrenragment"
        android:name="com.example.studyinbetterlogin.fragment.Pattrenragment"
        android:label="fragment_pattrenragment"
        tools:layout="@layout/fragment_pattrenragment" >
        <action
            android:id="@+id/action_pattrenragment_to_surePatternFragment"
            app:destination="@id/surePatternFragment" />
    </fragment>
    <fragment
        android:id="@+id/surePatternFragment"
        android:name="com.example.studyinbetterlogin.fragment.SurePatternFragment"
        android:label="fragment_sure_pattern"
        tools:layout="@layout/fragment_sure_pattern" >
        <action
            android:id="@+id/action_surePatternFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>
    <fragment
        android:id="@+id/loginByParrernFragment"
        android:name="com.example.studyinbetterlogin.fragment.LoginByParrernFragment"
        android:label="fragment_login_by_parrern"
        tools:layout="@layout/fragment_login_by_parrern" >
        <action
            android:id="@+id/action_loginByParrernFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>
</navigation>